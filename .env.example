# External data sources - required for pipeline runs
SEC_API_KEY=
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# S3 data lake - required for pipeline runs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
BUCKET_NAME=

# Local PostgreSQL service
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datasource

# Local Airflow administrator
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_FIRSTNAME=Data
AIRFLOW_ADMIN_LASTNAME=Engineer
AIRFLOW_ADMIN_EMAIL=admin@example.com
