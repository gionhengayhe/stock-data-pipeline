          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_Start Date' datatype='date' default-value-field='[federated.11qdke01tbc8mv13ne5071r7qorc].[Calculation_1280146811641856]' name='[Parameter 1300762280890369]' param-domain-type='any' role='measure' type='quantitative' value='#2026-08-10#'>
              <calculation class='tableau' formula='#2026-08-10#' />
            </column>
            <column caption='p_End Date' datatype='date' default-value-field='[federated.11qdke01tbc8mv13ne5071r7qorc].[Min Date (copy)_1280146811752449]' name='[Parameter 1300762280984578]' param-domain-type='any' role='measure' type='quantitative' value='#2026-08-31#'>
              <calculation class='tableau' formula='#2026-08-31#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11qdke01tbc8mv13ne5071r7qorc'>
            <column caption='Min Date' datatype='date' name='[Calculation_1280146811641856]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MIN([date]) }' />
            </column>
            <column caption='Advancer Rate' datatype='integer' default-format='p0.00%' name='[Calculation_AdvancerFlag]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [open] &gt; 0 THEN IF [close] &gt; [open] THEN 1 ELSE 0 END END' />
            </column>
            <column caption='Estimated Trading Value' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;-&quot;$&quot;#,##0,,.0M' name='[Calculation_ApproxDollarVolume]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[volume] * [volume_weighted]' />
            </column>
            <column caption='Daily Return' datatype='real' default-format='p0.00%' name='[Calculation_DailyReturn]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [open] &gt; 0 THEN [close] / [open] - 1 END' />
            </column>
            <column caption='Estimated Trading Value Share' datatype='real' default-format='p0.00%' name='[Calculation_DollarVolumeShare]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_ApproxDollarVolume]) / WINDOW_SUM(SUM([Calculation_ApproxDollarVolume]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sector Activity Intensity' datatype='real' hidden='true' name='[Calculation_SectorActivityIntensity]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOG(SUM([Calculation_ApproxDollarVolume]) + 1)' />
            </column>
            <column caption='Filter - Market Date Range' datatype='boolean' name='[Calculation_MarketDateRange]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;= [Parameters].[Parameter 1300762280890369] AND [date] &lt;= [Parameters].[Parameter 1300762280984578]' />
            </column>
            <column caption='Sector Clean' datatype='string' name='[Calculation_SectorClean]' role='dimension' type='nominal'>
