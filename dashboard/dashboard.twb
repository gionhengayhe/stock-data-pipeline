            <column caption='Market Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_DailyReturn]' derivation='Median' name='[med:Calculation_DailyReturn:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_MarketDateRange]' derivation='None' name='[none:Calculation_MarketDateRange:nk]' pivot='key' type='nominal' />
