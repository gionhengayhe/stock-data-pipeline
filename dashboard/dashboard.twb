    <worksheet name='Sector Trading Activity'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#17324d' fontsize='10'>Estimated trading value share by sector</run>
            <run fontalignment='2'>Æ&#10;</run>
            <run bold='false' fontalignment='2' fontcolor='#6b7a88' fontsize='8'>Sector contribution to estimated trading value within selected dates</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_candles+ (stock_data)' name='federated.11qdke01tbc8mv13ne5071r7qorc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_Start Date' datatype='date' default-value-field='[federated.11qdke01tbc8mv13ne5071r7qorc].[Calculation_1280146811641856]' name='[Parameter 1300762280890369]' param-domain-type='any' role='measure' type='quantitative' value='#2026-08-10#'>
              <calculation class='tableau' formula='#2026-08-10#' />
            </column>
            <column caption='p_End Date' datatype='date' default-value-field='[federated.11qdke01tbc8mv13ne5071r7qorc].[Min Date (copy)_1280146811752449]' name='[Parameter 1300762280984578]' param-domain-type='any' role='measure' type='quantitative' value='#2026-08-31#'>
              <calculation class='tableau' formula='#2026-08-31#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11qdke01tbc8mv13ne5071r7qorc'>
            <column caption='Min Date' datatype='date' name='[Calculation_1280146811641856]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MIN([date]) }' />
            </column>
            <column caption='Estimated Trading Value' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;-&quot;$&quot;#,##0,,.0M' name='[Calculation_ApproxDollarVolume]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[volume] * [volume_weighted]' />
            </column>
            <column caption='Estimated Trading Value Share' datatype='real' default-format='p0.00%' name='[Calculation_DollarVolumeShare]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_ApproxDollarVolume]) / WINDOW_SUM(SUM([Calculation_ApproxDollarVolume]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Filter - Market Date Range' datatype='boolean' name='[Calculation_MarketDateRange]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &gt;= [Parameters].[Parameter 1300762280890369] AND [date] &lt;= [Parameters].[Parameter 1300762280984578]' />
            </column>
            <column caption='Sector Clean' datatype='string' name='[Calculation_SectorClean]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([sector]) OR TRIM([sector]) = &quot;&quot; OR LOWER(TRIM([sector])) = &quot;null&quot; THEN &quot;Unknown&quot; ELSE TRIM([sector]) END' />
            </column>
            <column caption='Max Date' datatype='date' name='[Min Date (copy)_1280146811752449]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX([date]) }' />
            </column>
            <column caption='Market Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_MarketDateRange]' derivation='None' name='[none:Calculation_MarketDateRange:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_SectorClean]' derivation='None' name='[none:Calculation_SectorClean:nk]' pivot='key' type='nominal' />
            <column caption='Sector' datatype='string' name='[sector]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_ApproxDollarVolume]' derivation='Sum' name='[sum:Calculation_ApproxDollarVolume:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_DollarVolumeShare]' derivation='User' name='[usr:Calculation_DollarVolumeShare:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column caption='Volume' datatype='integer' name='[volume]' role='measure' type='quantitative' />
            <column caption='Volume Weighted' datatype='real' name='[volume_weighted]' role='measure' type='quantitative' />
