    <worksheet name='Sector Summary Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#17324d' fontsize='10'>Sector performance summary</run>
            <run fontalignment='2'>Æ&#10;</run>
            <run bold='false' fontalignment='2' fontcolor='#6b7a88' fontsize='8'>Color intensity compares estimated trading value on a log scale; rows sorted descending</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_candles+ (stock_data)' name='federated.11qdke01tbc8mv13ne5071r7qorc' />
