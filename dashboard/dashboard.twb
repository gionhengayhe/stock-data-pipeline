      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.11qdke01tbc8mv13ne5071r7qorc].[__tableau_internal_object_id__].[cnt:dim!companies_266E81EF3974452F9A28958AF19D6823:qk]&quot;' value='Linked Companies' />
          <alias key='&quot;[federated.11qdke01tbc8mv13ne5071r7qorc].[avg:Calculation_AdvancerFlag:qk]&quot;' value='Advancer Rate' />
          <alias key='&quot;[federated.11qdke01tbc8mv13ne5071r7qorc].[avg:overall_sentiment_score:qk]&quot;' value='Overall Sentiment Score' />
          <alias key='&quot;[federated.11qdke01tbc8mv13ne5071r7qorc].[avg:relevance_score:qk]&quot;' value='Relevance Score' />
          <alias key='&quot;[federated.11qdke01tbc8mv13ne5071r7qorc].[avg:ticker_sentiment_score:qk]&quot;' value='Ticker Sentiment Score' />
          <alias key='&quot;[federated.11qdke01tbc8mv13ne5071r7qorc].[med:Calculation_DailyReturn:qk]&quot;' value='Median Intraday Return' />
          <alias key='&quot;[federated.11qdke01tbc8mv13ne5071r7qorc].[sum:Calculation_ApproxDollarVolume:qk]&quot;' value='Estimated Trading Value' />
          <alias key='&quot;[federated.11qdke01tbc8mv13ne5071r7qorc].[sum:close:qk]&quot;' value='Close' />
          <alias key='&quot;[federated.11qdke01tbc8mv13ne5071r7qorc].[sum:num_of_trades:qk]&quot;' value='Number of Trades' />
          <alias key='&quot;[federated.11qdke01tbc8mv13ne5071r7qorc].[sum:open:qk]&quot;' value='Open' />
          <alias key='&quot;[federated.11qdke01tbc8mv13ne5071r7qorc].[usr:Calculation_DollarVolumeShare:qk:2]&quot;' value='Estimated Trading Value Share' />
        </aliases>
      </column>
      <column caption='Min Date' datatype='date' name='[Calculation_1280146811641856]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MIN([date]) }' />
      </column>
      <column caption='Advancer Rate' datatype='integer' default-format='p0.00%' name='[Calculation_AdvancerFlag]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [open] &gt; 0 THEN IF [close] &gt; [open] THEN 1 ELSE 0 END END' />
      </column>
      <column caption='Analysis Eligible' datatype='boolean' name='[Calculation_AnalysisEligible]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[open] &gt;= 1 AND [volume] &gt;= 100000' />
      </column>
      <column caption='Estimated Trading Value' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;-&quot;$&quot;#,##0,,.0M' name='[Calculation_ApproxDollarVolume]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[volume] * [volume_weighted]' />
      </column>
      <column caption='Article Share' datatype='real' default-format='p0.00%' name='[Calculation_ArticleShare]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id (dim!news)]) / WINDOW_SUM(COUNTD([id (dim!news)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Country' datatype='string' name='[Calculation_CountryClean]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([location]) OR TRIM([location]) = &quot;&quot; THEN &quot;Unknown&quot;&#10;ELSEIF UPPER(TRIM(IF CONTAINS([location], &quot;;&quot;) THEN SPLIT([location], &quot;;&quot;, 2) ELSE [location] END)) = &quot;U.S.A&quot;&#10;    OR UPPER(TRIM(IF CONTAINS([location], &quot;;&quot;) THEN SPLIT([location], &quot;;&quot;, 2) ELSE [location] END)) = &quot;U.S.A.&quot;&#10;    OR UPPER(TRIM(IF CONTAINS([location], &quot;;&quot;) THEN SPLIT([location], &quot;;&quot;, 2) ELSE [location] END)) = &quot;U.S.&quot;&#10;THEN &quot;United States&quot;&#10;ELSEIF UPPER(TRIM(IF CONTAINS([location], &quot;;&quot;) THEN SPLIT([location], &quot;;&quot;, 2) ELSE [location] END)) = &quot;CANADA (FEDERAL LEVEL)&quot; THEN &quot;Canada&quot;&#10;ELSEIF UPPER(TRIM(IF CONTAINS([location], &quot;;&quot;) THEN SPLIT([location], &quot;;&quot;, 2) ELSE [location] END)) = &quot;REPUBLIC OF KOREA&quot; THEN &quot;South Korea&quot;&#10;ELSEIF UPPER(TRIM(IF CONTAINS([location], &quot;;&quot;) THEN SPLIT([location], &quot;;&quot;, 2) ELSE [location] END)) = &quot;RUSSIAN FEDERATION&quot; THEN &quot;Russia&quot;&#10;ELSEIF UPPER(TRIM(IF CONTAINS([location], &quot;;&quot;) THEN SPLIT([location], &quot;;&quot;, 2) ELSE [location] END)) = &quot;DEMOCRATIC PEOPLE&apos;S REPUBLIC OF KOREA&quot; THEN &quot;North Korea&quot;&#10;ELSEIF UPPER(TRIM(IF CONTAINS([location], &quot;;&quot;) THEN SPLIT([location], &quot;;&quot;, 2) ELSE [location] END)) = &quot;ISRAEL-SYRIA&quot;&#10;    OR UPPER(TRIM(IF CONTAINS([location], &quot;;&quot;) THEN SPLIT([location], &quot;;&quot;, 2) ELSE [location] END)) = &quot;ISRAEL-JORDAN&quot;&#10;THEN &quot;Israel&quot;&#10;ELSE TRIM(IF CONTAINS([location], &quot;;&quot;) THEN SPLIT([location], &quot;;&quot;, 2) ELSE [location] END)&#10;END' />
        <semantic-values semantic-role='[Country].[Name]'>
          <semantic-value key='&quot;Netherlands Antilles&quot;' value='&quot;Netherlands&quot;' />
        </semantic-values>
      </column>
      <column caption='Daily Return' datatype='real' default-format='p0.00%' name='[Calculation_DailyReturn]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [open] &gt; 0 THEN [close] / [open] - 1 END' />
      </column>
      <column caption='Estimated Trading Value Share' datatype='real' default-format='p0.00%' name='[Calculation_DollarVolumeShare]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_ApproxDollarVolume]) / WINDOW_SUM(SUM([Calculation_ApproxDollarVolume]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sector Activity Intensity' datatype='real' hidden='true' name='[Calculation_SectorActivityIntensity]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG(SUM([Calculation_ApproxDollarVolume]) + 1)' />
      </column>
      <column caption='Industry Clean' datatype='string' name='[Calculation_IndustryClean]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([industry]) OR TRIM([industry]) = &quot;&quot; OR LOWER(TRIM([industry])) = &quot;null&quot; THEN &quot;Unknown&quot; ELSE TRIM([industry]) END' />
      </column>
