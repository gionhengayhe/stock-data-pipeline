            </column>
            <column caption='p_End Date' datatype='date' default-value-field='[federated.11qdke01tbc8mv13ne5071r7qorc].[Min Date (copy)_1280146811752449]' name='[Parameter 1300762280984578]' param-domain-type='any' role='measure' type='quantitative' value='#2026-08-30#'>
