    <worksheet name='Top News Topics by Article Links'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#17324d' fontsize='10'>Top topics by linked articles</run>
            <run fontalignment='2'>Æ&#10;</run>
            <run bold='false' fontalignment='2' fontcolor='#6b7a88' fontsize='8'>Distinct article links within the selected news dates</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_candles+ (stock_data)' name='federated.11qdke01tbc8mv13ne5071r7qorc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_Start Date' datatype='date' default-value-field='[federated.11qdke01tbc8mv13ne5071r7qorc].[Calculation_1280146811641856]' name='[Parameter 1300762280890369]' param-domain-type='any' role='measure' type='quantitative' value='#2026-08-10#'>
              <calculation class='tableau' formula='#2026-08-10#' />
            </column>
            <column caption='p_End Date' datatype='date' default-value-field='[federated.11qdke01tbc8mv13ne5071r7qorc].[Min Date (copy)_1280146811752449]' name='[Parameter 1300762280984578]' param-domain-type='any' role='measure' type='quantitative' value='#2026-08-31#'>
              <calculation class='tableau' formula='#2026-08-31#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11qdke01tbc8mv13ne5071r7qorc'>
            <column caption='Min Date' datatype='date' name='[Calculation_1280146811641856]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MIN([date]) }' />
            </column>
            <column caption='Filter - News Date Range' datatype='boolean' name='[Calculation_NewsDateRange]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date (dim!time1)] &gt;= [Parameters].[Parameter 1300762280890369] AND [date (dim!time1)] &lt;= [Parameters].[Parameter 1300762280984578]' />
            </column>
            <column caption='Max Date' datatype='date' name='[Min Date (copy)_1280146811752449]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX([date]) }' />
            </column>
            <column-instance column='[new_id (fact!news!topics)]' derivation='CountD' name='[ctd:new_id (fact!news!topics):qk]' pivot='key' type='quantitative' />
            <column caption='News Date' datatype='date' name='[date (dim!time1)]' role='dimension' type='ordinal' />
            <column caption='Market Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Topic' datatype='string' name='[name (dim!topics)]' role='dimension' type='nominal' />
            <column caption='New Id (Fact!News!Topics)' datatype='integer' name='[new_id (fact!news!topics)]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_NewsDateRange]' derivation='None' name='[none:Calculation_NewsDateRange:nk]' pivot='key' type='nominal' />
            <column-instance column='[name (dim!topics)]' derivation='None' name='[none:name (dim!topics):nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.11qdke01tbc8mv13ne5071r7qorc].[none:Calculation_NewsDateRange:nk]'>
            <groupfilter function='member' level='[none:Calculation_NewsDateRange:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.11qdke01tbc8mv13ne5071r7qorc].[none:name (dim!topics):nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='COUNTD([new_id (fact!news!topics)])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:name (dim!topics):nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.11qdke01tbc8mv13ne5071r7qorc].[none:name (dim!topics):nk]' direction='DESC' using='[federated.11qdke01tbc8mv13ne5071r7qorc].[ctd:new_id (fact!news!topics):qk]' />
          <slices>
            <column>[federated.11qdke01tbc8mv13ne5071r7qorc].[none:Calculation_NewsDateRange:nk]</column>
            <column>[federated.11qdke01tbc8mv13ne5071r7qorc].[none:name (dim!topics):nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.11qdke01tbc8mv13ne5071r7qorc].[ctd:new_id (fact!news!topics):qk]' scope='cols' value='Linked Articles' />
            <format attr='title' class='0' field='[federated.11qdke01tbc8mv13ne5071r7qorc].[none:name (dim!topics):nk]' scope='rows' value='' />
